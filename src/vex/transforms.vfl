int seed = chi("../../random_seed");
// Stable id and independent random streams: adding points preserves old draws.
vector jitter = set(rand(set(i@id,seed,11)), rand(set(i@id,seed,12)), rand(set(i@id,seed,13)))*2-1;
vector angles = set(rand(set(i@id,seed,21)), rand(set(i@id,seed,22)), rand(set(i@id,seed,23)))*2-1;
@P += jitter*chv("../../position_random");
vector rotation = radians(chv("../../base_rotation") + angles*chv("../../rotation_random"));
p@orient = eulertoquaternion(rotation, XFORM_XYZ);
float variation = clamp(chf("../../scale_random"), 0.0, 0.99);
float s = max(0.0001, chf("../../base_scale"))*(1.0 + (2.0*rand(set(i@id,seed,31))-1.0)*variation);
v@scale = set(s,s,s);
