// Circle / Radial points. Angles are measured counter-clockwise looking down the plane normal, 0 at the plane's first axis:
//   XZ (ground, normal +Y): p = r*( cos t, 0, -sin t )     XY (normal +Z): p = r*( cos t, sin t, 0 )     YZ (normal +X): p = r*( 0, cos t, sin t )
// A full circle (arc 360) spaces Count points evenly without repeating the first one; a partial arc places the first point at
// Start and the last at Start + Arc. Facing writes an alignment quaternion (p@align) that the variation stage composes last.
int count = clamp(chi("../../circle_count"), 1, 10000);
float radius = max(0.0, chf("../../circle_radius"));
float start = radians(chf("../../circle_start"));
float arc = clamp(chf("../../circle_arc"), 0.0, 360.0);
int plane = clamp(chi("../../circle_plane"), 0, 2);
int facing = clamp(chi("../../circle_facing"), 0, 3);
vector u, v, n;
int nidx;
if (plane == 0)      { u = {1,0,0}; v = {0,0,-1}; n = {0,1,0}; nidx = 1; }
else if (plane == 1) { u = {1,0,0}; v = {0,1,0};  n = {0,0,1}; nidx = 2; }
else                 { u = {0,1,0}; v = {0,0,1};  n = {1,0,0}; nidx = 0; }
// Reference "forward" axis of a prototype for this plane: the axis after the normal (Y -> Z, Z -> X, X -> Y).
vector ref = {0,0,0};
ref[(nidx + 1) % 3] = 1;
vector refside = cross(n, ref);
float step = 0.0;
if (count > 1) step = arc >= 359.9999 ? 2.0*PI/float(count) : radians(arc)/float(count - 1);
for (int i = 0; i < count; i++) {
    float t = start + float(i)*step;
    vector radial = cos(t)*u + sin(t)*v;
    int pt = addpoint(0, radius*radial);
    setpointattrib(0, "id", pt, i, "set");
    vector4 align = {0,0,0,1};
    if (facing > 0) {
        vector dir = radial;                                   // Outward
        if (facing == 2) dir = -radial;                        // Center
        if (facing == 3) dir = -sin(t)*u + cos(t)*v;           // Tangent (counter-clockwise)
        // Turn the prototype's forward axis about the plane normal until it points along dir.
        align = quaternion(atan2(dot(dir, refside), dot(dir, ref)), n);
    }
    setpointattrib(0, "align", pt, align, "set");
}
