int seed = chi("../../random_seed");
// Triangle-wave fold: reflects x back into [-h, h] however far it overshoots.
float fold(float x; float h) {
    if (h <= 0.0) return 0.0;
    float period = 4.0*h;
    float shifted = x + h;
    float m = shifted - period*floor(shifted/period);   // in [0, period)
    return m <= 2.0*h ? m - h : 3.0*h - m;
}
// Stable id and independent random streams: adding points preserves old draws.
vector jitter = set(rand(set(i@id,seed,11)), rand(set(i@id,seed,12)), rand(set(i@id,seed,13)))*2-1;
vector angles = set(rand(set(i@id,seed,21)), rand(set(i@id,seed,22)), rand(set(i@id,seed,23)))*2-1;
@P += jitter*chv("../../position_random");
// Optional: keep Area jitter inside the Area rectangle (X and Z only; Y jitter stays free).
if (chi("../../mode") == 1 && chi("../../area_keepinside")) {
    @P.x = fold(@P.x, 0.5*max(0.0, chf("../../area_sizex")));
    @P.z = fold(@P.z, 0.5*max(0.0, chf("../../area_sizez")));
}
// Scale Instances off: Bounds Scale stretches only the layout. Scale the point positions about the Pivot here
// (the USD transform then carries rotation and translation only), so the instances keep their own size.
// Physics Settle always works this way: the layout scales, the stones keep their size (a stretched rigid body makes no sense).
if (!chi("../../bound_scale_instances") || chi("../../phys_on")) {
    vector pivot = chv("../../bound_p");
    @P = pivot + (@P - pivot)*max(set(0.0001,0.0001,0.0001), chv("../../bound_s"));
}
// ROTATION variation. Euler XYZ: each axis varies by its own +/- amount (0 locks that axis). Yaw Only: only the Y Euler angle varies,
// by +/- Yaw (deg); the X/Z amounts are ignored. Either way it is added to Instance Transform > Rotation.
vector spread = chi("../../rotation_random_mode") == 1 ? set(0.0, angles.y*chf("../../yaw_random"), 0.0) : angles*chv("../../rotation_random");
vector rotation = radians(chv("../../base_rotation") + spread);
p@orient = eulertoquaternion(rotation, XFORM_XYZ);
// ALIGNMENT hook: a generator (Circle facing today; Curve/Surface later) may write p@align. It turns the instance after its own
// rotation, so Instance Transform > Rotation and Randomize still apply in the prototype's own frame.
if (haspointattrib(0, "align")) p@orient = qmultiply(p@align, p@orient);
// SCALE variation. Fraction +/-: Base x (1 +/- Amount). Min / Max: Base x a uniform value between Minimum and Maximum (swapped if
// reversed, never below 0.0001). The uniform draw (stream 31) is unchanged from earlier versions.
float base = max(0.0001, chf("../../base_scale"));
float u = rand(set(i@id,seed,31));
float s;
if (chi("../../scale_random_mode") == 1) {
    float lo = max(0.0001, min(chf("../../scale_min"), chf("../../scale_max")));
    float hi = max(0.0001, max(chf("../../scale_min"), chf("../../scale_max")));
    s = base*lerp(lo, hi, u);
} else {
    s = base*(1.0 + (2.0*u - 1.0)*clamp(chf("../../scale_random"), 0.0, 0.99));
}
// Non-Uniform: each axis gets its own independent (1 +/- amount) on top (streams 32-34); an amount of 0 locks that axis.
vector spreadscale = clamp(chv("../../scale_nonuniform"), 0.0, 0.99);
vector axes = set(1.0 + (2.0*rand(set(i@id,seed,32)) - 1.0)*spreadscale.x,
                  1.0 + (2.0*rand(set(i@id,seed,33)) - 1.0)*spreadscale.y,
                  1.0 + (2.0*rand(set(i@id,seed,34)) - 1.0)*spreadscale.z);
v@scale = s*axes;
// Imported Points (v1.5.0): the scale of the source point (pscale / scale attribute times the multiplier) multiplies the variation scale. Absent for every other distribution.
if (haspointattrib(0, "srcscale")) v@scale *= v@srcscale;
